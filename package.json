{
  "name": "vite-template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit && tsc -p worker/tsconfig.json --noEmit && tsc -p tools/indexer/tsconfig.json --noEmit && tsc -p probe/tsconfig.json --noEmit",
    "test": "bun test",
    "check": "bun scripts/check.mjs",
    "bench": "bun scripts/benchmark-search.mjs",
    "bench:real": "bun scripts/benchmark-search.mjs --index-dir .indexer-output",
    "bench:hydration": "bun scripts/benchmark-hydration.mjs",
    "search:explain": "bun scripts/explain-query.mjs",
    "index:audit": "bun scripts/association-audit.mjs",
    "index:assoc-scenarios": "bun scripts/association-scenarios.mjs",
    "r2:doctor": "bun scripts/r2-doctor.mjs",
    "r2:schema": "bun scripts/r2-schema.mjs",
    "verify:r2": "bun scripts/verify-raw.mjs",
    "verify:r2:remote": "bun scripts/verify-r2-remote.mjs",
    "index:profile": "bun tools/indexer/src/cli.ts profile --config tools/indexer/indexer.config.json",
    "index:sample": "bun tools/indexer/src/cli.ts run --config tools/indexer/indexer.config.json --sample 100000 --version v1-sample-100k",
    "index:benchmark-1m": "bun tools/indexer/src/cli.ts run --config tools/indexer/indexer.config.json --sample 1000000 --version v1-bench-1m",
    "index:benchmark-1m:preflight": "bun tools/indexer/src/cli.ts run --config tools/indexer/indexer.config.json --sample 1000000 --version v1-bench-1m --preflight-only",
    "index:benchmark-1m-assoc": "bun tools/indexer/src/cli.ts pass2-from-spool --config tools/indexer/indexer.config.json --source-work-dir .indexer-work --work-dir .indexer-work-v1-bench-1m-assoc --output-dir .indexer-output-assoc --version v1-bench-1m-assoc --expect-sample 1000000",
    "index:spool-doctor": "bun scripts/spool-doctor.mjs --config tools/indexer/indexer.config.json",
    "index:bench-pass2": "bun scripts/benchmark-pass2.mjs",
    "index:bench-assoc": "bun scripts/benchmark-association.mjs",
    "index:run": "bun tools/indexer/src/cli.ts run --config tools/indexer/indexer.config.json --version v1",
    "index:upload": "bun tools/indexer/src/cli.ts run --config tools/indexer/indexer.config.json --version v1 --upload",
    "index:sample-report": "bun scripts/sample-report.mjs",
    "index:validate": "bun tools/indexer/src/cli.ts validate --config tools/indexer/indexer.config.json --version v1",
    "index:publish": "bun tools/indexer/src/cli.ts publish --config tools/indexer/indexer.config.json --version v1 --yes"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@oslojs/crypto": "^1.0.1",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.1.17",
    "@tanstack/react-query": "^5.104.3",
    "@vly-ai/integrations": "^0.6.14",
    "@zumer/snapdom": "^2.0.1",
    "axios": "^1.13.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.23.25",
    "hono": "^4.10.7",
    "idb": "^8.0.4",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.555.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.0",
    "react-day-picker": "9.13.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.67.0",
    "react-intersection-observer": "^10.0.0",
    "react-resizable-panels": "^3.0.6",
    "react-router": "^7.10.0",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.17",
    "vaul": "^1.1.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261015.1",
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "prettier": "3.7.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.1",
    "vite": "^7.2.6"
  }
}
